@page
@model InvoiceTracking.Web.Pages.UploadModel

@{
  ViewData["Title"] = "Upload Invoice";
}

<h1>Upload New Invoice</h1>
<form method="post" enctype="multipart/form-data">
  <div class="mb-3">
    <label class="form-label">Invoice file (PDF or image)</label>
    <input type="file" name="invoiceFile" class="form-control" accept=".pdf,.docx,.jpg,.jpeg,.png" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Invoice number</label>
    <input type="text" name="InvoiceNumber" class="form-control" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Vendor name</label>
    <input type="text" name="VendorName" class="form-control" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Total amount</label>
    <input type="number" step="0.01" name="TotalAmount" class="form-control" required />
  </div>
  <div class="mb-3">
    <label class="form-label">Invoice date</label>
    <input type="date" name="InvoiceDate" class="form-control" required />
  </div>

  <button type="submit" class="btn btn-primary">Upload invoice</button>
</form>